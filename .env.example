# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/sahaayak

# JWT Configuration
# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# OpenAI Configuration (for AI-powered hiring assessments)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_RETRIES=2

# Assessment Configuration
# Options: 'openai' or 'rule-based'
ASSESSMENT_METHOD=openai
# Whether to use fallback if primary method fails
USE_ASSESSMENT_FALLBACK=true

# Retell voice assistant (optional; without these the voice assistant is unavailable)
RETELL_API_KEY=your_retell_api_key_here
RETELL_AGENT_ID=your_retell_agent_id_here

# Google Places API (for loan suggestions)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Server
PORT=5050
# Comma-separated list of frontend URLs allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Max login/signup attempts per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=20

# Geocoder for place search and city lookup: nominatim (free, no signup) | none (offline)
GEOCODER=nominatim
